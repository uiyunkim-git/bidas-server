# ── Secrets and local configuration ──────────────────────────────────────
# NOTE: .gitignore has no trailing comments. Anything after a pattern on the
# same line becomes part of the pattern and silently matches nothing.
.env

# ── Runtime state, never commit ──────────────────────────────────────────
# the MinIO object store itself
data/
# regenerated by the bootstrap container on every start
overlay/minio.json

# ── Fetched, not tracked ─────────────────────────────────────────────────
# upstream site; run ./scripts/update-web.sh
web/
# MinIO client binary (~30 MB)
scripts/mc
# its credential store - holds the admin secret in plain text
scripts/.mc/

# ── Bulk data dropped into the seed directory ────────────────────────────
seed/**/*.fastq.gz
seed/**/*.fastq
seed/**/*.bam
seed/**/*.cram
seed/**/*.vcf.gz
seed/**/*.xlsx

# ── OS / editor cruft ────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*~
.idea/
.vscode/
@eaDir/
