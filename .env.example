# ─────────────────────────────────────────────────────────────
# BIDAS + MinIO stack configuration
# Copy to `.env` and adjust. `.env` is git-ignored.
# ─────────────────────────────────────────────────────────────

COMPOSE_PROJECT_NAME=bidas

# --- Public address (used for links, redirects, docs) ---------
# Exactly what the browser's address bar shows. No trailing slash.
#
# This stack speaks plain HTTP only - it never terminates TLS and never
# redirects to https. The reverse proxy in front does that. This value just
# has to agree with the address people actually use, because the MinIO console
# builds its redirects from it and both guide pages fill their sample commands
# with it.
PUBLIC_URL="https://bidas.kaist.ac.kr"

# --- Host ports (point your external reverse proxy here) ------
# Web site + embedded data browser + MinIO console  ->  PUBLIC_URL
BIDAS_HTTP_PORT=14541
# Raw S3 API root (for mc / aws-cli / boto3)        ->  PUBLIC_URL:14542
BIDAS_S3_PORT=14542

# --- MinIO ----------------------------------------------------
# Latest published community container. Pin a RELEASE.* tag for reproducibility.
MINIO_IMAGE="minio/minio:latest"

# Initial root (admin) credentials, applied on every start.
# The password is baked into the storage volume the first time MinIO runs, so
# set a real one BEFORE the first `docker compose up`. Minimum 8 characters.
MINIO_ROOT_USER="admin"
MINIO_ROOT_PASSWORD="CHANGE-ME-before-first-start"

MINIO_REGION=us-east-1

# Where the MinIO console is reachable. It fixes the console's <base href> and
# its post-login redirect, so it must match the address people open. Normally
# just follows PUBLIC_URL; override it only to reach the NAS directly, e.g.
#   MINIO_CONSOLE_URL="http://143.248.31.14:14541/minio"
MINIO_CONSOLE_URL="${PUBLIC_URL}/minio"

# --- Buckets --------------------------------------------------
# Buckets to make sure exist on every start - one per collection on the
# "NGS Data" page. Nothing here is ever deleted, and buckets you create by
# hand in the console are untouched by this list.
#
# Layout inside a bucket: rna-seq/<brain-region>/<files>
#   e.g. neuropathology-consortium/rna-seq/hippocampus/S042_R1.fastq.gz
#
# All buckets are private. Reaching an object needs a signed request - the
# console, mc, or a presigned share link - never a plain URL.
BIDAS_BUCKETS="neuropathology-consortium array-collection new-collection depression-collection combined-collections"

# Buckets opened to anonymous download, i.e. reachable at
# https://bidas.kaist.ac.kr/<bucket>/<object> with no credentials at all.
# Empty means every bucket is private - which is the intent here. Only add a
# name if you deliberately want that bucket world-readable, and never one that
# collides with a website path (css, js, images, analytics, *.html).
BIDAS_PUBLIC_BUCKETS=""

# --- Seeding --------------------------------------------------
# When true, ./seed/<bucket>/ is mirrored into each bucket on every start.
# Off by default so a restart never resurrects objects you deleted, and so
# large uploads are not routed through this directory. The files under ./seed
# stay on disk either way; push them by hand with:
#   ./scripts/mc.sh mirror seed/shared/ bidas/shared/
BIDAS_SEED_ON_START=false

# --- Service accounts -----------------------------------------
# Both blank on purpose:
#   * uploads go through the root account above
#   * a download account will be added later
#
# The policies they attach to are created on every start regardless, so
# turning one on is just filling in a name and a password here, or:
#
#   ./scripts/mc.sh admin user add bidas alice 'long-random-password'
#   ./scripts/mc.sh admin policy attach bidas bidas-readonly --user alice
#
#   bidas-readonly  list + download, every bucket including ones made later
#   bidas-upload    the above plus write, delete, create-bucket - but no
#                   admin rights: cannot add users or change server settings
#
# Filling these in creates the account on the next start. Changing a password
# here has no effect once the account exists - see README, "Credentials".
BIDAS_READONLY_USER=""
BIDAS_READONLY_PASSWORD=""

BIDAS_UPLOAD_USER=""
BIDAS_UPLOAD_PASSWORD=""
